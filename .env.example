# ─────────────────────────────────────────────────────────────────────
#  aws-tagging-utils — Environment Configuration
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to Git.
# ─────────────────────────────────────────────────────────────────────

# ── AWS Identity ──────────────────────────────────────────────────────
# Primary region for all AWS API calls
AWS_DEFAULT_REGION=ap-south-1

# (Optional) Only needed if NOT using EC2 instance profile or IAM role.
# Leave blank on EC2 — the instance profile is used automatically.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# ── Authentication Mode ───────────────────────────────────────────────
# local_dev  → bypasses ALB OIDC; uses DEV_AUTH_USER below
# alb_oidc   → requires ALB in front; verifies JWT from x-amzn-oidc-data header
AUTH_MODE=local_dev

# ── Dev Auth Identity (only used when AUTH_MODE=local_dev) ───────────
# Format: username:Role1,Role2
# Supported roles: admin, viewer, finops
DEV_AUTH_USER=admin:admin

# ── ALB Auth (only used when AUTH_MODE=alb_oidc) ─────────────────────
# ARN of your Application Load Balancer (for JWT signer verification)
# AUTH_ALB_ARN=arn:aws:elasticloadbalancing:ap-south-1:123456789012:loadbalancer/app/my-alb/abc123
# Region where the ALB is deployed (for public key lookup)
# AUTH_AWS_REGION=ap-south-1

# ── SQLite Persistence ────────────────────────────────────────────────
# Path inside the container. The docker-compose volume maps this to a
# named Docker volume so data survives restarts.
SQLITE_DB_PATH=/app/data/app.db

# ── Governance / Tag Schema ───────────────────────────────────────────
# Path to tag-schema.yaml (relative to /app inside container)
GOVERNANCE_SCHEMA_PATH=config/tag-schema.yaml

# Mandatory tags enforced by compliance scan (comma-separated)
# These are derived from tag-schema.yaml by default; override here if needed
MANDATORY_TAGS=Owner,Environment

# Governance behaviour:
#   warn    → log unknown tags but don't fail
#   reject  → reject resources with unknown tags
GOVERNANCE_UNKNOWN_TAGS=warn
GOVERNANCE_STRICT_MODE=true
GOVERNANCE_NORMALIZATION=true

# ── Remediation Engine ────────────────────────────────────────────────
GOVERNANCE_REMEDIATION_ENABLED=true
GOVERNANCE_GRACE_PERIOD_DAYS=7
GOVERNANCE_TERMINATION_ENABLED=false
MAX_REMEDIATION_ATTEMPTS=3

# DynamoDB table for governance state (leave blank to use SQLite only)
# GOVERNANCE_DYNAMODB_TABLE=TagGovernanceState

# SNS topic ARN for governance notifications (optional)
# GOVERNANCE_SNS_TOPIC_ARN=arn:aws:sns:ap-south-1:123456789012:tag-governance-alerts

# ── Worker / SQS ──────────────────────────────────────────────────────
WORKER_ENABLED=false
# SQS_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/123456789012/tag-governance-queue
SQS_WAIT_TIME_SECONDS=20
SQS_VISIBILITY_TIMEOUT_SECONDS=900
SQS_MAX_MESSAGES=10
WORKER_SHUTDOWN_TIMEOUT_SECONDS=30

# ── FinOps / Cost Explorer ────────────────────────────────────────────
FINOPS_ENABLED=true
FINOPS_AUTO_ACTIVATE_COST_TAGS=false
DRIFT_ENABLED=true
DRIFT_AUTO_REVERT=false

# ── Multi-Account (cross-account AssumeRole) ──────────────────────────
MULTI_ACCOUNT_ROLE_NAME=AWSOrganizationTagGovernanceRole

# ── S3 Report Bucket (optional) ───────────────────────────────────────
# REPORT_BUCKET=my-tag-governance-reports

# ── Logging ───────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# json → structured JSON logs (recommended for CloudWatch / production)
# text → human-readable logs (for local dev)
LOG_FORMAT=json

# ── API Performance ───────────────────────────────────────────────────
TAG_API_BATCH_SIZE=20
TAG_LOOKUP_RETRIES=10
TAG_LOOKUP_DELAY_SEC=1.5

# ── Boto Retry Configuration ──────────────────────────────────────────
BOTO_MAX_RETRIES=5
BOTO_RETRY_MODE=adaptive

# ── RBAC / Observability ──────────────────────────────────────────────
RBAC_ENABLED=false
OBSERVABILITY_ENABLED=true
