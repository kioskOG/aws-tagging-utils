# ─────────────────────────────────────────────────────────────────────
#  aws-tagging-utils — Environment Configuration
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to Git.
# ─────────────────────────────────────────────────────────────────────

# ── AWS Identity ──────────────────────────────────────────────────────
# Primary region for all AWS API calls
AWS_DEFAULT_REGION=ap-south-1

# (Optional) Only needed if NOT using EC2 instance profile or IAM role.
# Leave blank on EC2 — the instance profile is used automatically.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# ── Authentication Mode ───────────────────────────────────────────────
# local_dev  → bypasses ALB OIDC; uses DEV_AUTH_USER below
# alb_oidc   → requires ALB in front; verifies JWT from x-amzn-oidc-data header
AUTH_MODE=local_dev

# ── Dev Auth Identity (only used when AUTH_MODE=local_dev) ───────────
# Format: username:Role1,Role2   (role names are case-sensitive)
# Roles: PlatformAdmin, SecurityAdmin, TagOperator, ApplicationOwner, FinOps, Viewer
DEV_AUTH_USER=admin:PlatformAdmin

# ── ALB Auth (only used when AUTH_MODE=alb_oidc) ─────────────────────
# ARN of your Application Load Balancer (for JWT signer verification)
# AUTH_ALB_ARN=arn:aws:elasticloadbalancing:ap-south-1:123456789012:loadbalancer/app/my-alb/abc123
# Region where the ALB is deployed (for public key lookup)
# AUTH_AWS_REGION=ap-south-1
# JWT claim that carries the IdP groups (Cognito: cognito:groups)
# AUTH_GROUPS_CLAIM=groups
# Map IdP groups to app roles
# AUTH_ROLE_MAPPING={"aws-platform-admins":"PlatformAdmin","finops":"FinOps","security":"SecurityAdmin"}

# ── SQLite Persistence ────────────────────────────────────────────────
# Path inside the container. The docker-compose volume maps this to a
# named Docker volume so data survives restarts.
SQLITE_DB_PATH=/app/data/app.db

# ── Governance / Tag Schema ───────────────────────────────────────────
# Path to tag-schema.yaml (relative to /app inside container)
GOVERNANCE_SCHEMA_PATH=config/tag-schema.yaml

# Mandatory tags enforced by compliance scans (comma-separated), in addition to
# every tag marked `required: true` in tag-schema.yaml
MANDATORY_TAGS=Owner,Environment

# Tags not defined in the schema:
#   warn    → reported as warnings; resource stays compliant
#   reject  → resource is non-compliant
#   allow   → ignored
# (aws:* reserved tags are always ignored)
GOVERNANCE_UNKNOWN_TAGS=warn
GOVERNANCE_STRICT_MODE=true
GOVERNANCE_NORMALIZATION=true

# ── Remediation Engine ────────────────────────────────────────────────
# false → report-only: POST /api/remediation returns 403 and the enforcement
# Lambda records violations without changing resources
GOVERNANCE_REMEDIATION_ENABLED=true
GOVERNANCE_GRACE_PERIOD_DAYS=7
# Reserved (not implemented — resources are never terminated)
GOVERNANCE_TERMINATION_ENABLED=false
MAX_REMEDIATION_ATTEMPTS=3

# DynamoDB table (partition key "PK", String) holding exemptions and remediation
# actions. Required for the Exemptions / Remediation features; defaults to TagGovernanceState.
# GOVERNANCE_DYNAMODB_TABLE=TagGovernanceState

# SNS topic ARN for governance notifications (optional)
# GOVERNANCE_SNS_TOPIC_ARN=arn:aws:sns:ap-south-1:123456789012:tag-governance-alerts

# ── Compliance scanning ──────────────────────────────────────────────
# Regions for background/scheduled scans: comma list or "all" (default: AWS_DEFAULT_REGION)
# COMPLIANCE_REGIONS=ap-south-1,us-east-1
# A cached scan older than this is "stale" and refreshed (seconds)
COMPLIANCE_CACHE_TTL_SECONDS=300
# Server-side scheduled scans: check every N seconds, scan when stale (0 = off)
COMPLIANCE_SCAN_INTERVAL_SECONDS=0
# Completed scans kept in SQLite for the trend chart
SCAN_RETENTION=30

# ── Inventory (full coverage) ────────────────────────────────────────
# tagging           → Resource Groups Tagging API (cannot see never-tagged resources)
# resource_explorer → AWS Resource Explorer + tagging API (finds never-tagged resources too)
INVENTORY_SOURCE=tagging
# Region of the Resource Explorer aggregator index (blank = each scanned region's local index)
# RESOURCE_EXPLORER_REGION=ap-south-1
# RESOURCE_EXPLORER_VIEW_ARN=
# mapped → evaluate RESOURCE_TYPE_MAP types, report others as coverage gaps; all → evaluate everything
COMPLIANCE_SCOPE=mapped

# ── Multi-account ─────────────────────────────────────────────────────
# blank → only this account; "all" → every ACTIVE account in the Organization; or a comma list
# COMPLIANCE_ACCOUNTS=all
# MULTI_ACCOUNT_EXTERNAL_ID=

# ── Leaderboards, owner view, history ─────────────────────────────────
TEAM_TAG_KEY=Team
HISTORY_RETENTION_DAYS=90
# Tags matched against the signed-in user's id/email for "My resources"
OWNER_MATCH_TAGS=Owner
# Email used for owner matching in local_dev (ALB OIDC uses the JWT email claim)
# DEV_AUTH_EMAIL=you@example.com
EXEMPTION_EXPIRY_WARNING_DAYS=14
OWNER_COST_CACHE_SECONDS=21600

# ── Bulk changes & propagation ────────────────────────────────────────
MAX_BULK_RESOURCES=1000
# Never copied from parent to child (comma list)
PROPAGATE_EXCLUDE_KEYS=Name
# schema (tags defined in tag-schema.yaml) | all | comma list
PROPAGATE_KEYS=schema
CHANGESET_RETENTION_DAYS=90

# ── Worker / SQS ──────────────────────────────────────────────────────
# (reserved, not read yet — the worker runs whenever started with SQS_QUEUE_URL set)
WORKER_ENABLED=false
# SQS_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/123456789012/tag-governance-queue
SQS_WAIT_TIME_SECONDS=20
SQS_VISIBILITY_TIMEOUT_SECONDS=900
SQS_MAX_MESSAGES=10
WORKER_SHUTDOWN_TIMEOUT_SECONDS=30

# ── FinOps / Cost Explorer ────────────────────────────────────────────
# false → /api/finops* return 404 FEATURE_DISABLED and the UI hides spend
FINOPS_ENABLED=true
# FINOPS_PRIMARY_TAG=CostCenter
# Reserved (not read yet):
FINOPS_AUTO_ACTIVATE_COST_TAGS=false
DRIFT_ENABLED=true
DRIFT_AUTO_REVERT=false

# ── Multi-Account (cross-account AssumeRole) ──────────────────────────
MULTI_ACCOUNT_ROLE_NAME=AWSOrganizationTagGovernanceRole

# ── S3 Report Bucket (optional) ───────────────────────────────────────
# REPORT_BUCKET=my-tag-governance-reports

# ── Logging ───────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# json → structured JSON logs (recommended for CloudWatch / production)
# text → human-readable logs (for local dev)
LOG_FORMAT=json

# ── API Performance ───────────────────────────────────────────────────
TAG_API_BATCH_SIZE=20
TAG_LOOKUP_RETRIES=10
TAG_LOOKUP_DELAY_SEC=1.5

# ── Boto Retry Configuration ──────────────────────────────────────────
BOTO_MAX_RETRIES=5
BOTO_RETRY_MODE=adaptive

# ── Observability ─────────────────────────────────────────────────────
# Prometheus metrics at GET /metrics
OBSERVABILITY_ENABLED=true
# Optional bearer token required to scrape /metrics
# METRICS_AUTH_TOKEN=change-me
# CloudWatch Embedded Metric Format lines on stdout (Lambda / ECS)
METRICS_EMF_ENABLED=false
METRICS_NAMESPACE=TagGovernance

# ── MCP server ────────────────────────────────────────────────────────
# true → write_tags / apply_governance / sync_tags are refused
MCP_READ_ONLY=false

# ── RBAC ──────────────────────────────────────────────────────────────
# Reserved (not read): RBAC is always enforced on the web API.
RBAC_ENABLED=false
